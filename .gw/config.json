{
  "$schema": "https://raw.githubusercontent.com/mthines/gw-tools/main/packages/gw-tool/schemas/gw-config.schema.json",
  "configVersion": 3,
  "defaultBranch": "main",
  "cleanThreshold": 7,
  "hooks": {
    "checkout": {
      "post": ["pnpm install"]
    }
  },
  "autoCopyFiles": [
    "packages/web/.vercel",
    "packages/web/.env.local",
    ".env.local",
    ".mcp.json"
]
}
