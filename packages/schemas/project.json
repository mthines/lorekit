{
  "name": "schemas",
  "$schema": "../../node_modules/nx/schemas/project.json",
  "projectType": "library",
  "sourceRoot": "packages/schemas/src",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsc --noEmit -p packages/schemas/tsconfig.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "generate:openapi": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [{ "input": "default", "projects": ["schemas"] }],
      "outputs": ["{workspaceRoot}/supabase/functions/openapi/openapi.generated.json"],
      "options": {
        "command": "npx tsx packages/schemas/src/openapi/generate.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
