{
  "name": "schemas",
  "$schema": "../../node_modules/nx/schemas/project.json",
  "projectType": "library",
  "sourceRoot": "packages/schemas/src",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsc --noEmit -p packages/schemas/tsconfig.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "generate:llms": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        {
          "input": "default",
          "projects": [
            "schemas"
          ]
        },
        "{workspaceRoot}/packages/web/src/content/docs/**/*.mdx"
      ],
      "outputs": [
        "{workspaceRoot}/packages/web/public/llms.txt"
      ],
      "options": {
        "command": "node --experimental-transform-types packages/schemas/src/llms/generate.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "check:llms": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        {
          "input": "default",
          "projects": [
            "schemas"
          ]
        },
        "{workspaceRoot}/packages/web/src/content/docs/**/*.mdx",
        "{workspaceRoot}/packages/web/public/llms.txt"
      ],
      "outputs": [],
      "options": {
        "command": "node --experimental-transform-types packages/schemas/src/llms/generate.ts --check",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
