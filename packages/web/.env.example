# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://pqokxlhvnosogizsjztg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-publishable-key>
NEXT_PUBLIC_SUPABASE_PROJECT_REF=pqokxlhvnosogizsjztg

# ── App ────────────────────────────────────────────────────────────────────────
# The single canonical dashboard origin. Used for the OAuth redirectTo,
# metadataBase, and invite-email links. Locally this is the dev server; in
# production set it to the real domain, e.g. https://lorekit.io.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ── GitHub App ────────────────────────────────────────────────────────────────
# The GitHub App's slug (from github.com/apps/<slug>). Renders the "Install
# GitHub App" button on Settings → Webhooks, linking to the public install page.
# Leave unset until the App is registered AND GITHUB_APP_ENABLED=true is set as a
# Supabase secret — otherwise the button offers an install the backend ignores.
# See docs/github-app.md.
# NEXT_PUBLIC_GITHUB_APP_SLUG=lorekitbot

# ── Org invite emails (Resend) ────────────────────────────────────────────────
# Optional. When RESEND_API_KEY is unset, org invites are in-app only (no email
# sent) — everything still works. To send invite emails, set an API key and a
# verified sending address (verify the domain in Resend first). Locally these
# are usually left unset so no email ships in dev.
# RESEND_API_KEY=re_...
# RESEND_FROM=LoreKit <invites@lorekit.io>

# ── Deployment environment ────────────────────────────────────────────────────
# Vercel injects VERCEL_ENV automatically ('production' | 'preview' | 'development').
# For local dev this is absent — instrumentation maps it to 'local'.
# You don't need to set this manually; it's exposed via next.config.ts.
# NEXT_PUBLIC_VERCEL_ENV=local   ← leave commented; auto-set by Vercel

# ── Dash0 Server-side OTel (OTLP → Dash0) ─────────────────────────────────────
# These are already set via OTEL_* env vars — same token as the MCP server.
# Vercel auto-injects VERCEL_GIT_COMMIT_SHA for service.version.
OTEL_SERVICE_NAME=web

# ── Dash0 Client-side RUM (browser → Dash0) ───────────────────────────────────
# Create a SEPARATE auth token with Ingesting-only permissions.
# This token IS PUBLIC — it is embedded in the browser bundle.
# Endpoint: https://app.dash0.com/settings/endpoints → OTLP via HTTP
# Token:    https://app.dash0.com/settings/auth-tokens → Create (Ingesting only)
NEXT_PUBLIC_DASH0_OTLP_ENDPOINT=https://ingress.europe-west4.gcp.dash0-dev.com
NEXT_PUBLIC_DASH0_AUTH_TOKEN=<ingesting-only-auth-token>
