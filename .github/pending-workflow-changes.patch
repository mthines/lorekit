index b0134efb..667ab538 100644
--- a/.github/workflows/deploy.yml
+++ b/.github/workflows/deploy.yml
@@ -11,9 +11,9 @@
 #
 #   deploy-preview (API) ────────┐
 #   deploy-web-preview (FE) ──────┤
-#   stage-web-production (FE build)┘
+#   stage-web-production (FE build)┘─▶ e2e-web-staged (Playwright) ──────────┐
 #            └─▶ smoke-preview ─▶ deploy-production (API) ─▶ promote-web-production (FE)
-#                                          └────────────────────────┴─▶ smoke-production
+#                                          └────────────────────────┴─▶ smoke-production (+ Playwright)
 #                                                                            ├─▶ rollback-production (functions)
 #                                                                            └─▶ rollback-web-production (Vercel)
 #   any job fails ─▶ notify-failure (Discord + Dash0)
@@ -48,6 +48,12 @@
 # The fixed smoke user those secrets name must already exist on the project — seed it
 # once with `node scripts/smoke/seed-smoke-user.mjs` (see docs/deployment.md → "Seed
 # the orgs-smoke user"); the mint signs in as it, it is never auto-created.
+# Optional repo-level secrets for the website e2e suite (packages/web-e2e,
+# docs/smoke-tests.md): VERCEL_AUTOMATION_BYPASS_SECRET lets e2e-web-staged reach
+# the staged build through Vercel Deployment Protection (unset → that job skips,
+# announced, and promotion proceeds as before); LOREKIT_TESTING_USER_NAME +
+# LOREKIT_TESTING_USER_PW sign in a production test account for the signed-in
+# pages (unset → those tests skip, announced; public pages still run).
 # Optional repo-level secret: DISCORD_WEBHOOK_URL — when set, notify-failure posts
 # a message there on any deploy-pipeline failure. Unset → notify-failure no-ops.
 # Add a required reviewer on the `production` environment for a manual gate.
@@ -395,6 +401,91 @@ jobs:
           echo "### Web production (staged)" >> "$GITHUB_STEP_SUMMARY"
           echo "- Built and uploaded: $URL (domain not yet applied)" >> "$GITHUB_STEP_SUMMARY"
 
+  # ── 1d. Website e2e against the STAGED production build ───────────────────────
+  #    Playwright (packages/web-e2e) against the exact bundle promote-web-production
+  #    is about to put on the production domain — so a broken page stops the flip
+  #    instead of being rolled back after users saw it. The staged URL is behind
+  #    Vercel Deployment Protection; VERCEL_AUTOMATION_BYPASS_SECRET gets through it
+  #    and, while it is unset, this job skips (announced) and promotion proceeds
+  #    exactly as before.
+  #
+  #    Signed-in pages run here only when this merge leaves the API alone. When the
+  #    API changed too, it reaches production only AFTER this job (deploy-production),
+  #    so the staged bundle would be tested against an API it will never be served
+  #    with; those pages run in smoke-production instead, once both halves are live.
+  #
+  #    No `environment:` — a required reviewer on `production` must not gate a test.
+  e2e-web-staged:
+    name: Web e2e → staged production build (Playwright)
+    runs-on: ubuntu-latest
+    needs: [changes, stage-web-production]
+    if: needs.stage-web-production.result == 'success'
+    timeout-minutes: 20
+    permissions:
+      contents: read
+    env:
+      E2E_BASE_URL: ${{ needs.stage-web-production.outputs.deployment_url }}
+      # The staged build talks to the PRODUCTION backend, whatever its URL says.
+      E2E_TARGET: production
+      VERCEL_AUTOMATION_BYPASS_SECRET: ${{ secrets.VERCEL_AUTOMATION_BYPASS_SECRET }}
+      E2E_USER_EMAIL: ${{ secrets.LOREKIT_TESTING_USER_NAME }}
+      E2E_USER_PASSWORD: ${{ secrets.LOREKIT_TESTING_USER_PW }}
+      API_CHANGED: ${{ needs.changes.outputs.api }}
+    steps:
+      - name: Skip without the Vercel bypass secret
+        id: gate
+        run: |
+          if [ -z "$VERCEL_AUTOMATION_BYPASS_SECRET" ]; then
+            echo "::warning::VERCEL_AUTOMATION_BYPASS_SECRET is not set — the staged build is behind Vercel Deployment Protection, so the website e2e gate is SKIPPED. Add the secret (Vercel ▸ Project ▸ Settings ▸ Deployment Protection ▸ Protection Bypass for Automation) to turn it on."
+            echo "run=false" >> "$GITHUB_OUTPUT"
+          else
+            echo "run=true" >> "$GITHUB_OUTPUT"
+          fi
+
+      - name: Checkout repository
+        if: steps.gate.outputs.run == 'true'
+        uses: actions/checkout@v7.0.1
+
+      - name: Set up pnpm
+        if: steps.gate.outputs.run == 'true'
+        uses: pnpm/action-setup@v6
+
+      - name: Set up Node.js
+        if: steps.gate.outputs.run == 'true'
+        uses: actions/setup-node@v7.1.0
+        with:
+          node-version: 20
+          cache: pnpm
+
+      - name: Install dependencies
+        if: steps.gate.outputs.run == 'true'
+        run: pnpm install --frozen-lockfile
+
+      - name: Install Playwright Chromium (+ OS deps)
+        if: steps.gate.outputs.run == 'true'
+        run: pnpm --filter @lorekit/web-e2e exec playwright install --with-deps chromium
+
+      - name: Playwright — staged build
+        if: steps.gate.outputs.run == 'true'
+        working-directory: packages/web-e2e
+        run: |
+          if [ "$API_CHANGED" = "true" ]; then
+            echo "::notice::This merge changes the API too — signed-in pages run in smoke-production, after both halves are live."
+            npx playwright test --project=public
+          else
+            npx playwright test --project=public --project=signed-in
+          fi
+
+      - name: Upload the Playwright report (traces + screenshots)
+        if: failure()
+        uses: actions/upload-artifact@v7
+        with:
+          name: web-e2e-staged-report
+          path: |
+            packages/web-e2e/playwright-report
+            packages/web-e2e/test-results
+          retention-days: 14
+
   # ── 2. Integration test against PREVIEW (the gate before prod) ────────────────
   smoke-preview:
     name: Smoke tests → preview
@@ -528,6 +619,29 @@ jobs:
           URL: https://${{ secrets.SUPABASE_PROJECT_REF }}.supabase.co/functions/v1/mcp
           TOKEN: ${{ secrets.LOREKIT_SMOKE_TOKEN }}
 
+      # Every `lorekit` command, through the real binary, against the deploy that
+      # just landed (packages/cli/test/smoke, remote lane). The PR gate already ran
+      # the same cases offline; this proves them against a real backend. It
+      # writes only under its own `project::cli-smoke-<run>` scope and hard-deletes
+      # what it wrote, and refuses production by itself — preview only, like the
+      # MCP surface smoke above. Retried once: the run is self-contained, so a
+      # re-run after a transient flake is safe and a real regression still fails.
+      - name: Smoke — every CLI command against preview
+        run: |
+          for attempt in 1 2; do
+            node packages/cli/test/smoke/run.mjs --remote "$URL" "$TOKEN" && break
+            rc=$?
+            if [ "$attempt" -eq 2 ]; then
+              echo "::error::CLI smoke failed after $attempt attempts"
+              exit "$rc"
+            fi
+            echo "::warning::CLI smoke failed (attempt $attempt/2) — retrying in 10s (transient live-endpoint flake)..."
+            sleep 10
+          done
+        env:
+          URL: https://${{ secrets.SUPABASE_PROJECT_REF }}.supabase.co/functions/v1/mcp
+          TOKEN: ${{ secrets.LOREKIT_SMOKE_TOKEN }}
+
       # Mint a user JWT so smoke-rest can include the orgs suite. Fixed-user mode
       # (LOREKIT_SMOKE_EMAIL/PASSWORD) — never provisions users in a real tenant,
       # unlike CI's ephemeral mode against a throwaway local stack. Runs only when
@@ -711,13 +825,15 @@ jobs:
   promote-web-production:
     name: Promote web → production (Vercel)
     runs-on: ubuntu-latest
-    needs: [changes, deploy-production, stage-web-production]
-    # Flip the web when it changed (stage-web-production ran) AND either the API
+    needs: [changes, deploy-production, stage-web-production, e2e-web-staged]
+    # Flip the web when it changed (stage-web-production ran), its staged build
+    # passed the website e2e (e2e-web-staged — green when it skips for a missing
+    # bypass secret), AND either the API
     # did not change (nothing to wait for) or the API's prod deploy succeeded (so
     # the API is live before the FE fronts it). `changes.outputs.api` disambiguates
     # deploy-production's 'skipped' (API unchanged, fine) from a real upstream stop
     # (API changed but its deploy failed / smoke-preview failed → not 'success').
-    if: always() && needs.stage-web-production.result == 'success' && (needs.changes.outputs.api == 'false' || needs.deploy-production.result == 'success')
+    if: always() && needs.stage-web-production.result == 'success' && needs.e2e-web-staged.result == 'success' && (needs.changes.outputs.api == 'false' || needs.deploy-production.result == 'success')
     environment: production
     permissions:
       # `write` for this job's own deployed-SHA marker, nothing else.
@@ -917,6 +1033,35 @@ jobs:
             exit 1
           fi
 
+      # The website, in a browser, as users get it now that both halves are live:
+      # every public page, every dashboard page's signed-out redirect, and — with
+      # the test account secrets — every dashboard page signed in plus the shell
+      # journeys (packages/web-e2e). Read-only: page views and nothing else (the
+      # sign-out journey skips itself on production — it would revoke the shared
+      # account's other sessions). A failure here trips both rollbacks, like the
+      # curl above; the suite retries each test twice on CI before failing.
+      - name: Install Playwright Chromium (+ OS deps)
+        run: pnpm --filter @lorekit/web-e2e exec playwright install --with-deps chromium
+
+      - name: Web e2e — every page against production (Playwright)
+        working-directory: packages/web-e2e
+        env:
+          E2E_BASE_URL: ${{ vars.WEB_PROD_URL || 'https://lorekit.io' }}
+          E2E_TARGET: production
+          E2E_USER_EMAIL: ${{ secrets.LOREKIT_TESTING_USER_NAME }}
+          E2E_USER_PASSWORD: ${{ secrets.LOREKIT_TESTING_USER_PW }}
+        run: npx playwright test --project=public --project=signed-in
+
+      - name: Upload the Playwright report (traces + screenshots)
+        if: failure()
+        uses: actions/upload-artifact@v7
+        with:
+          name: web-e2e-production-report
+          path: |
+            packages/web-e2e/playwright-report
+            packages/web-e2e/test-results
+          retention-days: 14
+
       # Full authenticated onboarding + round-trip against the live production
       # deploy, mirroring smoke-preview: scaffold skill + config, then
       # `doctor --deep` (self-cleaning write→read→delete). Stronger than the
@@ -1222,7 +1367,7 @@ jobs:
   notify-failure:
     name: Notify on failure (Discord + Dash0)
     runs-on: ubuntu-latest
-    needs: [changes, deploy-preview, deploy-web-preview, stage-web-production, smoke-preview, deploy-production, promote-web-production, smoke-production, rollback-production, rollback-web-production]
+    needs: [changes, deploy-preview, deploy-web-preview, stage-web-production, e2e-web-staged, smoke-preview, deploy-production, promote-web-production, smoke-production, rollback-production, rollback-web-production]
     if: always() && contains(needs.*.result, 'failure')
     permissions:
       contents: read # checkout, so the local composite action is available
@@ -1237,6 +1382,7 @@ jobs:
           RESULT_DEPLOY_PREVIEW: ${{ needs.deploy-preview.result }}
           RESULT_DEPLOY_WEB_PREVIEW: ${{ needs.deploy-web-preview.result }}
           RESULT_STAGE_WEB_PRODUCTION: ${{ needs.stage-web-production.result }}
+          RESULT_E2E_WEB_STAGED: ${{ needs.e2e-web-staged.result }}
           RESULT_SMOKE_PREVIEW: ${{ needs.smoke-preview.result }}
           RESULT_DEPLOY_PRODUCTION: ${{ needs.deploy-production.result }}
           RESULT_PROMOTE_WEB_PRODUCTION: ${{ needs.promote-web-production.result }}
@@ -1251,6 +1397,7 @@ jobs:
           elif [ "$RESULT_DEPLOY_PREVIEW"         = "failure" ]; then failed="deploy → preview"
           elif [ "$RESULT_DEPLOY_WEB_PREVIEW"     = "failure" ]; then failed="web deploy → preview"
           elif [ "$RESULT_STAGE_WEB_PRODUCTION"   = "failure" ]; then failed="web build (production staging)"
