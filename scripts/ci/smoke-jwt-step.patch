# TEMPORARY FILE — apply, then delete. Not part of the shipped tree.
#
#   git apply scripts/ci/smoke-jwt-step.patch && git rm scripts/ci/smoke-jwt-step.patch
#
# (or `git apply -3 …` if ci.yml has moved since this was generated)
#
# Adds a step that mints a Supabase user JWT for the orgs REST smoke suite and
# passes it to the existing REST smoke step. Agent0's push credential lacks the
# GitHub App `workflows` permission, so .github/ changes cannot be pushed
# directly — hence a patch rather than a commit.
#
# Generated with `git diff` against ci.yml at commit b6b0ba0, so the hunk
# offsets are real, not hand-written. Verified with `git apply --check`.
#
# WHY a mint step and not a repository secret: a Supabase access token expires
# (jwt_expiry 86400s locally, 3600s hosted). A stored one is dead within a day,
# and its failure mode is silent — orgs-api.integration self-skips on a
# falsy/rejected credential, so an expired token reports the suite as green
# while testing nothing.
#
# This unlocks the 5 org read-back tests (which do not run at all today) and
# the positive usage_events assertion, which needs a non-service caller.
#
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 6b6d60d..57aba62 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -250,15 +250,33 @@ jobs:
           TOKEN: ${{ steps.supabase.outputs.service_role_key }}
         run: node scripts/smoke-mcp-stdio.mjs "http://127.0.0.1:54321/functions/v1/mcp" "$TOKEN"
 
+      # The orgs suite needs a Supabase USER JWT — every `lorekit_org_*` RPC is
+      # SECURITY DEFINER and resolves the actor as `auth.uid()`, so the
+      # service-role key and `lk_*` tokens are both rejected. A JWT cannot be a
+      # stored secret (it expires: `jwt_expiry` is 86400s locally, 3600s hosted,
+      # and an expired one makes the suite self-skip green), so it is minted
+      # per run against the throwaway local stack.
+      - name: Mint a user JWT for the orgs smoke suite
+        id: smokejwt
+        env:
+          SUPABASE_URL: http://127.0.0.1:54321
+          SUPABASE_SERVICE_ROLE_KEY: ${{ steps.supabase.outputs.service_role_key }}
+        run: |
+          JWT="$(node scripts/mint-smoke-jwt.mjs)"
+          echo "::add-mask::$JWT"
+          echo "jwt=$JWT" >> "$GITHUB_OUTPUT"
+
       # Exercise the REST Edge Functions end-to-end against the live local
-      # stack. These specs self-skip without LOREKIT_SMOKE_TOKEN, so wiring
+      # stack. These specs self-skip without their credential, so wiring
       # them here is what actually makes them a merge gate — without this step
       # they exist but never run, and report a pass. They prove the `memories`
       # and `orgs` functions boot, authenticate, and honour their request
-      # contracts (including the OR+AND `filter` on POST /memories/search).
+      # contracts (including the OR+AND `filter` on POST /memories/search),
+      # and read `audit_log` back to prove the audit trail is really written.
       - name: Smoke — REST API (memories + orgs) against the live stack
         env:
           LOREKIT_SMOKE_TOKEN: ${{ steps.supabase.outputs.service_role_key }}
+          LOREKIT_SMOKE_JWT: ${{ steps.smokejwt.outputs.jwt }}
           LOREKIT_REST_BASE_URL: http://127.0.0.1:54321/functions/v1
         run: node scripts/smoke-rest.mjs
 
