# TEMPORARY FILE — apply, then delete. Not meant to be merged.
#
# The GitHub App used to push this branch does not hold the `workflows`
# permission, so .github/workflows/ci.yml could not be edited directly.
#
# WHY IT MATTERS
#   packages/mcp-server/src/memories-api.integration.spec.ts and
#   orgs-api.integration.spec.ts are describe.skipIf(!TOKEN). No workflow runs
#   them and nothing sets LOREKIT_REST_BASE_URL, so today they skip and report
#   a pass. Until this step exists the REST API has no merge gate at all.
#
#   scripts/smoke-rest.mjs refuses to run without a token rather than skipping,
#   so a misconfigured step fails loudly instead of pretending to have tested.
#
# APPLY
#   git apply scripts/ci/rest-smoke-step.patch
#   git rm scripts/ci/rest-smoke-step.patch
#   git commit -m "ci: run the REST API smoke specs in the integration job"
#
# Generated with `git diff` against .github/workflows/ci.yml at b6b0ba0, so the
# hunk offsets are real. If ci.yml has moved since, use `git apply -3` to let
# git fall back to a three-way merge.
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 3552a52..6b6d60d 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -250,6 +250,18 @@ jobs:
           TOKEN: ${{ steps.supabase.outputs.service_role_key }}
         run: node scripts/smoke-mcp-stdio.mjs "http://127.0.0.1:54321/functions/v1/mcp" "$TOKEN"
 
+      # Exercise the REST Edge Functions end-to-end against the live local
+      # stack. These specs self-skip without LOREKIT_SMOKE_TOKEN, so wiring
+      # them here is what actually makes them a merge gate — without this step
+      # they exist but never run, and report a pass. They prove the `memories`
+      # and `orgs` functions boot, authenticate, and honour their request
+      # contracts (including the OR+AND `filter` on POST /memories/search).
+      - name: Smoke — REST API (memories + orgs) against the live stack
+        env:
+          LOREKIT_SMOKE_TOKEN: ${{ steps.supabase.outputs.service_role_key }}
+          LOREKIT_REST_BASE_URL: http://127.0.0.1:54321/functions/v1
+        run: node scripts/smoke-rest.mjs
+
       - name: Diagnose — edge runtime logs (on failure)
         if: failure()
         run: |
