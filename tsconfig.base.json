{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "baseUrl": ".",
    "paths": {
      "@lorekit/core": ["packages/mcp-core/src/index.ts"],
      "@lorekit/schemas": ["packages/schemas/src/index.ts"],
      "@lorekit/schemas/scope.js": ["packages/schemas/src/scope.ts"],
      "@lorekit/schemas/memory.js": ["packages/schemas/src/memory.ts"],
      "@lorekit/schemas/org.js": ["packages/schemas/src/org.ts"],
      "@lorekit/schemas/common.js": ["packages/schemas/src/common.ts"]
    }
  }
}
